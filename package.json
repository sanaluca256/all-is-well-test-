{
  "name": "all-is-well",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix server install",
    "dev": "concurrently -n server,web -c blue,green \"npm --prefix server run dev\" \"vite\"",
    "dev:web": "vite",
    "dev:server": "npm --prefix server run dev",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.0.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
